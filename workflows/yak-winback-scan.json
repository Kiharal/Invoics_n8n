{
  "id": "yakWinbackScan01",
  "name": "yak-winback-scan",
  "active": false,
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000035",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000036",
      "name": "Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "\nconst env = (k, d) => { try { return ($env && $env[k]) || d; } catch (e) { return d; } };\nreturn [{ json: {\n  backend_url: env('BACKEND_URL', 'http://backend:3000'),\n  yak_key: env('YAK_KEY', ''),\n  ollama_url: env('OLLAMA_URL', 'http://ollama:11434'),\n  ollama_model: env('OLLAMA_MODEL', 'qwen2.5:7b'),\n  whatsapp_min_kes: Number(env('WHATSAPP_MIN_KES', 149)),\n  android_app_url: env('ANDROID_APP_URL', 'https://www.yakwetu.africa'),\n} }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000037",
      "name": "Find inactive users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.backend_url }}/api/users-inactive?threshold_s={{ (5.1 * Math.log(1 + 43200)).toFixed(1) }}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-yak-key",
              "value": "={{ $('Settings').first().json.yak_key }}"
            }
          ]
        }
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000038",
      "name": "To win-back events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "\nconst due = $input.all().map((i) => i.json).filter((j) => j && j.user_id);\nreturn due.map((d) => ({ json: { event: 'winback_due', user_id: d.user_id, demo_mode: true, context: { idle_s: d.idle_s } } }));"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000039",
      "name": "Push into pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.backend_url }}/api/events",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-yak-key",
              "value": "={{ $('Settings').first().json.yak_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
  ],
  "connections": {
    "Every 10 seconds": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Find inactive users",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find inactive users": {
      "main": [
        [
          {
            "node": "To win-back events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "To win-back events": {
      "main": [
        [
          {
            "node": "Push into pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "yakErrorAlerts01",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {},
  "tags": []
}