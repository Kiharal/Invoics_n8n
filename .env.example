# Shared secret between n8n and the backend (x-yak-key). tools/setup.sh generates one if empty.
YAK_KEY=

# AI lane. Real model via Ollama (start with: docker compose --profile ai up -d, or sh tools/setup.sh --ai),
# or the built-in stub on machines without an NVIDIA GPU (tools/setup.sh picks this when it creates .env):
#   OLLAMA_URL=http://backend:3000/mock-ollama
# n8n always calls the model through the backend (/ai), so the panel's AI switch works either way.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Paid WhatsApp marketing messages only for titles at or above this price (D6)
WHATSAPP_MIN_KES=149
ANDROID_APP_URL=https://www.yakwetu.africa

# Email, option 1 (preferred): Mailtrap Email Sandbox over HTTPS. Works on networks that block SMTP.
# Token: Mailtrap > Settings > API Tokens. Inbox id: the number in the sandbox URL. tools/mailtrap-sandbox.js fills the id.
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_TEST_INBOX_ID=
# Email, option 2: SMTP (Mailtrap sandbox SMTP settings). All empty = simulated.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=YAKWETU <nudges@demo.yakwetu.test>

# WhatsApp Cloud API test number. Empty = simulated.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0
# Optional: an approved template with ONE body variable. Empty = free-form text,
# which only works if the recipient messaged your test number in the last 24 hours.
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en

# Team phones, international format without "+", verified on the Meta test number
DEMO_PHONE_1=
DEMO_PHONE_2=
DEMO_PHONE_3=
DEMO_PHONE_4=
